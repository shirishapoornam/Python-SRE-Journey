servers = [
    {
        "name": "prod-api-01",
        "cpu": 45,
    },
    {
        "name": "prod-api-02",
        "cpu": 95,
    },
    {
        "name" : "prod-db-01",
        "cpu" : 72,
    },
    {
        "name" : "prod-db-02",
        "cpu" : 60,
    },
    {
        "name" : "prod-cache-01",
        "cpu" : 88,
    }
]
print("Monitoring servers")
for number, server in enumerate(servers, start=1):
    if server["cpu"] > 90 :
        server["status"] = "Critical"
    elif server ["cpu"] > 70 :
        server["status"] = "Warning"
    else:
        server["status"] = "Healthy"
    print("-----------------------------")
    print("Server_number   :", number)
    print("Server_name     :", server["name"])
    print("Cpu_usage       :", server["cpu"], "%")
    print("Server_status   :", server["status"])
print("Monitoring completed")
